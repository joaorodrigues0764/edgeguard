{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "edgeguard-staging",
	"main": "../src/staging.ts",
	"compatibility_date": "2026-10-01",
	"vars": {
		"TELEMETRY_DATASET": "edgeguard_staging_telemetry"
	},
	"triggers": {
		"crons": []
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"secrets": {
		"required": ["INGEST_API_TOKEN", "DASHBOARD_API_TOKEN", "ADMIN_API_TOKEN", "DASHBOARD_PASSWORD"]
	},
	"d1_databases": [
		{
			"binding": "edgeguard_db",
			"database_name": "edgeguard-staging-db",
			"database_id": "<STAGING_D1_DATABASE_ID>",
			"migrations_dir": "../migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "edgeguard-staging-events",
				"binding": "EVENTS_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "edgeguard-staging-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"retry_delay": 60,
				"dead_letter_queue": "edgeguard-staging-events-dlq"
			}
		]
	},
	"analytics_engine_datasets": [
		{
			"binding": "EDGEGUARD_ANALYTICS",
			"dataset": "edgeguard_staging_telemetry"
		}
	],
	"analytics": {
		"binding": "ANALYTICS_SQL"
	},
	"ratelimits": [
		{
			"name": "EVENT_INGEST_RATE_LIMITER",
			"namespace_id": "<UNUSED_STAGING_RATE_LIMIT_NAMESPACE>",
			"simple": {
				"limit": 10,
				"period": 10
			}
		}
	],
	"account_id": "<STAGING_ACCOUNT_ID>",
	"workers_dev": true,
	"preview_urls": false,
	"build": {
		"command": "node check.mjs --template",
		"cwd": "."
	}
}
